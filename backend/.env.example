# Backend API (Express + MongoDB). Copy ke backend/.env lalu isi nilainya.
# Jangan commit file .env yang berisi nilai asli.

PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ranger_db?retryWrites=true&w=majority

# Auth
JWT_SECRET=<random-64-hex>

# Google OAuth (verifikasi token)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-drive-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-drive-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-gdrive-folder-id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Email / SMTP
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# GEOVERSE points
GEOVERSE_POINT_RATE=0.01

# Midtrans (opsional)
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
